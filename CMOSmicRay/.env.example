# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real credentials.

# --- CREDO ACCOUNT ---
CREDO_USER=your_credo_username
CREDO_PASS=your_credo_password
CREDO_STATION=Your-Station-Name

# --- LOCATION ---
CREDO_LAT=0.0
CREDO_LNG=0.0
CREDO_ALT=0.0

# --- CAMERA SELECTION ---
# "C270", "C922", or anything else to fall back to the generic profile
CREDO_CAMERA_MODEL=C270

# --- HARDWARE & SOFTWARE ---
CREDO_DEVICE_MODEL=RPi Model B
CREDO_SOFTWARE_VERSION=2.0
