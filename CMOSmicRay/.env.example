# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real credentials.

# --- CREDO ACCOUNT ---
CREDO_USER=your_credo_username
CREDO_PASS=your_credo_password
CREDO_STATION=Your-Station-Name

# --- LOCATION ---
CREDO_LAT=0.0
CREDO_LNG=0.0
CREDO_ALT=0.0

# --- CAMERA SELECTION ---
# "C270", "C922", or anything else to fall back to the generic profile
CREDO_CAMERA_MODEL=C270

# --- HARDWARE & SOFTWARE ---
CREDO_DEVICE_MODEL=RPi Model B
CREDO_SOFTWARE_VERSION=v1.7.5

# --- SAFETY GATES (optional; defaults shown) ---
# Frames used to settle the background model before detection starts
#CALIBRATION_FRAMES=500
# Lens-cover check: mean brightness <= AVG_MAX and at least BLACK_MIN of pixels near-black.
# On failure detection pauses, shows the last 2 critical messages on the dashboard, and
# automatically recalibrates (500 frames) and resumes once the lens is covered again.
#OBSCURATION_AVG_MAX=10
#OBSCURATION_BLACK_MIN=0.05
# CPU temp (C): warn above SOFT, exit above CEILING, checked every INTERVAL seconds (logged every 5 min)
#THERMAL_SOFT_C=60
#THERMAL_CEILING_C=70
#THERMAL_CHECK_INTERVAL=30

# --- CAPTURE SIZE & HOT-PIXEL MASK (optional) ---
# Default 640x480. Pre-v1.7 data: hot-spot hits were 65% of accepted hits at 1280x720
# but 1% at 640x480. (The profile thresholds date from v1.3.0, a 1280x720 version.)
#CAPTURE_WIDTH=640
#CAPTURE_HEIGHT=480
# A position with this many accepted hits is masked as a sensor defect (0 = off).
# Learned positions persist in hot_pixels.json, per capture size.
#HOT_PIXEL_MIN_HITS=5
#HOT_PIXEL_RADIUS=3

# --- LIVE-TIME LOG (optional) ---
# live_stats.csv gets one row per window: frames processed and hits by status,
# so rates can be reported per live hour. Window length in seconds.
#STATS_WINDOW_S=3600

# --- TIMEZONE (optional) ---
# CSV files keep UTC in timestamp_iso and add a local-time column with UTC offset.
# The dashboard shows times in the station zone. Detected from the Pi (/etc/timezone);
# set this only to override. Use an IANA name so daylight saving is handled.
#STATION_TZ=America/New_York
